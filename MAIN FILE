<script>
// ══════════════════════════════
// CLOCK
// ══════════════════════════════
function updateClock() {
  const now = new Date();
  const h = String(now.getHours()).padStart(2,'0');
  const m = String(now.getMinutes()).padStart(2,'0');
  const s = String(now.getSeconds()).padStart(2,'0');
  document.getElementById('clock').textContent = `${h}:${m}:${s}`;
}
setInterval(updateClock, 1000);
updateClock();

// ══════════════════════════════
// WINDOW MANAGER
// ══════════════════════════════
let zBase = 100;
let activeWindow = null;

function openWindow(id) {
  const win = document.getElementById(id);
  if (!win) return;
  win.classList.add('visible');
  bringToFront(win);
  updateTaskbar();
  if (id === 'terminal-window') {
    setTimeout(() => document.getElementById('term-input').focus(), 100);
  }
}

function closeWindow(id) {
  const win = document.getElementById(id);
  if (win) {
    win.classList.remove('visible','maximized');
    updateTaskbar();
  }
}

function minWindow(id) {
  closeWindow(id);
}

function maxWindow(id) {
  const win = document.getElementById(id);
  if (win) win.classList.toggle('maximized');
}

function bringToFront(win) {
  zBase++;
  win.style.zIndex = zBase;
}

function updateTaskbar() {
  const wins = document.querySelectorAll('.window');
  wins.forEach(w => {
    const id = w.id;
    const btns = document.querySelectorAll('.taskbar-btn');
    btns.forEach(btn => {
      if (btn.getAttribute('onclick') && btn.getAttribute('onclick').includes(id)) {
        if (w.classList.contains('visible')) btn.classList.add('active');
        else btn.classList.remove('active');
      }
    });
  });
}

// Drag
document.querySelectorAll('.titlebar').forEach(tb => {
  let dragging = false, ox, oy;
  tb.addEventListener('mousedown', e => {
    if (e.target.classList.contains('win-btn')) return;
    const win = tb.parentElement;
    if (win.classList.contains('maximized')) return;
    dragging = true;
    bringToFront(win);
    ox = e.clientX - win.offsetLeft;
    oy = e.clientY - win.offsetTop;
    e.preventDefault();
  });
  document.addEventListener('mousemove', e => {
    if (!dragging) return;
    const win = tb.parentElement;
    let nx = e.clientX - ox;
    let ny = e.clientY - oy;
    nx = Math.max(0, Math.min(nx, window.innerWidth - win.offsetWidth));
    ny = Math.max(0, Math.min(ny, window.innerHeight - 48 - win.offsetHeight));
    win.style.left = nx + 'px';
    win.style.top = ny + 'px';
  });
  document.addEventListener('mouseup', () => dragging = false);
});

// Click to focus
document.querySelectorAll('.window').forEach(win => {
  win.addEventListener('mousedown', () => bringToFront(win));
});

