  </div>
</div>

<!-- Welcome badge -->
<div class="welcome-badge">
  <div class="welcome-line1">INITIALIZING SESSION</div>
  <div class="welcome-line2">WELCOME, OMAR</div>
  <div class="welcome-line3">// YOUR DEVELOPER WORKSPACE IS READY</div>
</div>

