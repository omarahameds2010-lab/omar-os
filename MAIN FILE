<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OmarOS v1.0</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #050a0f;
  --surface: #0a1520;
  --surface2: #0f1e2e;
  --border: #1a3a5c;
  --neon: #00f5ff;
  --neon2: #ff006e;
  --neon3: #7b2fff;
  --gold: #ffd700;
  --text: #c8e6f5;
  --text-dim: #4a7a9b;
  --glow: 0 0 20px rgba(0,245,255,0.4);
  --glow2: 0 0 20px rgba(255,0,110,0.4);
  --font-mono: 'Share Tech Mono', monospace;
  --font-head: 'Orbitron', monospace;
  --font-body: 'Rajdhani', sans-serif;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  background: var(--bg);
  font-family: var(--font-body);
  overflow: hidden;
  height: 100vh;
  width: 100vw;
  cursor: default;
  user-select: none;
}

/* Animated background grid */
.bg-grid {
  position: fixed;
  inset: 0;
  background-image:
    linear-gradient(rgba(0,245,255,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,245,255,0.03) 1px, transparent 1px);
  background-size: 40px 40px;
  animation: gridMove 20s linear infinite;
  pointer-events: none;
  z-index: 0;
}
@keyframes gridMove {
  0% { transform: translateY(0); }
  100% { transform: translateY(40px); }
}

/* Scanlines */
.scanlines {
  position: fixed;
  inset: 0;
  background: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 2px,
    rgba(0,0,0,0.15) 2px,
    rgba(0,0,0,0.15) 4px
  );
  pointer-events: none;
  z-index: 999;
  opacity: 0.4;
}

/* Watermark */
.watermark {
  position: fixed;
  right: 20px;
  bottom: 60px;
  font-family: var(--font-head);
  font-size: 11px;
  color: rgba(0,245,255,0.12);
  letter-spacing: 4px;
  writing-mode: vertical-rl;
  z-index: 1;
  pointer-events: none;
  text-transform: uppercase;
}

/* Boot screen */
#boot {
  position: fixed;
  inset: 0;
  background: #000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 10000;
  animation: bootFade 0.5s ease 3.5s forwards;
}
@keyframes bootFade {
  to { opacity: 0; pointer-events: none; }
}
.boot-logo {
  font-family: var(--font-head);
  font-size: clamp(28px, 5vw, 56px);
  font-weight: 900;
  color: var(--neon);
  text-shadow: var(--glow), 0 0 60px rgba(0,245,255,0.6);
  letter-spacing: 8px;
  animation: bootPulse 0.8s ease infinite alternate;
}
@keyframes bootPulse {
  from { opacity: 0.8; }
  to { opacity: 1; }
}
.boot-sub {
  font-family: var(--font-mono);
  font-size: 13px;
  color: var(--text-dim);
  margin-top: 16px;
  letter-spacing: 3px;
}
.boot-bar-wrap {
  margin-top: 40px;
  width: 300px;
  height: 2px;
  background: var(--surface2);
  border-radius: 2px;
  overflow: hidden;
}
.boot-bar {
  height: 100%;
  width: 0;
  background: linear-gradient(90deg, var(--neon3), var(--neon));
  box-shadow: var(--glow);
  animation: bootBar 3s ease forwards;
}
@keyframes bootBar { to { width: 100%; } }

/* Desktop */
#desktop {
  position: fixed;
  inset: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  animation: desktopReveal 0.6s ease 4s both;
}
@keyframes desktopReveal {
  from { opacity: 0; transform: scale(1.02); }
  to { opacity: 1; transform: scale(1); }
}

/* Taskbar */
#taskbar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  height: 48px;
  background: rgba(5,10,15,0.95);
  border-top: 1px solid var(--border);
  backdrop-filter: blur(20px);
  display: flex;
  align-items: center;
  padding: 0 16px;
  gap: 8px;
  z-index: 9000;
}
.taskbar-logo {
  font-family: var(--font-head);
  font-size: 14px;
  font-weight: 900;
  color: var(--neon);
  letter-spacing: 2px;
  text-shadow: var(--glow);
  margin-right: 12px;
  white-space: nowrap;
}
.taskbar-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 12px;
  border: 1px solid var(--border);
  border-radius: 4px;
  background: var(--surface);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  letter-spacing: 0.5px;
}
.taskbar-btn:hover { border-color: var(--neon); color: var(--neon); box-shadow: var(--glow); }
.taskbar-btn.active { border-color: var(--neon); background: rgba(0,245,255,0.08); color: var(--neon); }
.taskbar-icon { font-size: 13px; }
.taskbar-clock {
  margin-left: auto;
  font-family: var(--font-mono);
  font-size: 13px;
  color: var(--neon);
  letter-spacing: 2px;
  text-shadow: var(--glow);
  white-space: nowrap;
}

/* Desktop icons */
#icon-area {
  flex: 1;
  display: grid;
  grid-template-columns: repeat(auto-fill, 90px);
  grid-auto-rows: 100px;
  align-content: start;
  padding: 20px;
  gap: 10px;
}
.desk-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  cursor: pointer;
  padding: 10px 5px;
  border-radius: 8px;
  border: 1px solid transparent;
  transition: all 0.2s;
  width: 90px;
}
.desk-icon:hover {
  background: rgba(0,245,255,0.06);
  border-color: rgba(0,245,255,0.3);
  box-shadow: 0 0 15px rgba(0,245,255,0.1);
}
.desk-icon .icon-emoji { font-size: 32px; }
.desk-icon .icon-label {
  font-family: var(--font-body);
  font-size: 11px;
  color: var(--text);
  text-align: center;
  font-weight: 600;
  letter-spacing: 0.3px;
  text-shadow: 0 0 10px rgba(0,0,0,0.8);
  line-height: 1.2;
}

/* Windows */
.window {
  position: fixed;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  box-shadow: 0 20px 60px rgba(0,0,0,0.8), 0 0 0 1px rgba(0,245,255,0.05);
  display: none;
  flex-direction: column;
  z-index: 100;
  min-width: 320px;
  min-height: 200px;
  overflow: hidden;
  animation: windowOpen 0.2s ease;
}
@keyframes windowOpen {
  from { transform: scale(0.92); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.window.visible { display: flex; }
.window.maximized {
  top: 0 !important;
  left: 0 !important;
  width: 100vw !important;
  height: calc(100vh - 48px) !important;
  border-radius: 0;
}

/* Titlebar */
.titlebar {
  display: flex;
  align-items: center;
  padding: 0 12px;
  height: 36px;
  background: var(--surface2);
  border-bottom: 1px solid var(--border);
  cursor: move;
  flex-shrink: 0;
  gap: 10px;
}
.titlebar-icon { font-size: 14px; }
.titlebar-title {
  font-family: var(--font-head);
  font-size: 11px;
  font-weight: 700;
  color: var(--neon);
  letter-spacing: 2px;
  text-transform: uppercase;
  flex: 1;
}
.win-controls { display: flex; gap: 6px; }
.win-btn {
  width: 14px; height: 14px;
  border-radius: 50%;
  border: none;
  cursor: pointer;
  transition: opacity 0.2s;
  font-size: 0;
}
.win-btn:hover { opacity: 0.8; }
.win-close { background: #ff5f57; }
.win-max { background: #28c840; }
.win-min { background: #ffbd2e; }

/* Window content */
.win-content {
  flex: 1;
  overflow: auto;
  padding: 20px;
  scrollbar-width: thin;
  scrollbar-color: var(--border) transparent;
}

/* ============ ABOUT ME ============ */
.about-header {
  display: flex;
  align-items: center;
  gap: 24px;
  margin-bottom: 28px;
  padding-bottom: 24px;
  border-bottom: 1px solid var(--border);
}
.avatar {
  width: 80px; height: 80px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--neon3), var(--neon));
  display: flex; align-items: center; justify-content: center;
  font-size: 36px;
  box-shadow: 0 0 30px rgba(0,245,255,0.3);
  flex-shrink: 0;
}
.about-name {
  font-family: var(--font-head);
  font-size: clamp(18px, 3vw, 26px);
  font-weight: 900;
  color: var(--neon);
  text-shadow: var(--glow);
  letter-spacing: 2px;
}
.about-title {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--neon2);
  margin-top: 4px;
  letter-spacing: 1px;
}
.about-loc {
  font-size: 13px;
  color: var(--text-dim);
  margin-top: 6px;
  font-weight: 600;
}
.section-title {
  font-family: var(--font-head);
  font-size: 11px;
  font-weight: 700;
  color: var(--neon);
  letter-spacing: 3px;
  text-transform: uppercase;
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.section-title::after {
  content: '';
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, var(--border), transparent);
}
.skills-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 24px;
}
.skill-tag {
  padding: 5px 12px;
  border: 1px solid var(--border);
  border-radius: 20px;
  font-size: 12px;
  font-weight: 600;
  color: var(--text);
  background: var(--surface2);
  letter-spacing: 0.5px;
  transition: all 0.2s;
}
.skill-tag:hover { border-color: var(--neon); color: var(--neon); box-shadow: var(--glow); }
.skill-tag.hot { border-color: var(--neon2); color: var(--neon2); }
.skill-tag.cool { border-color: var(--neon3); color: var(--neon3); }
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 24px;
}
.info-card {
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 14px;
}
.info-card-label {
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--text-dim);
  letter-spacing: 2px;
  margin-bottom: 6px;
}
.info-card-value {
  font-size: 14px;
  font-weight: 700;
  color: var(--text);
}
.stat-bar-wrap { margin-bottom: 10px; }
.stat-label { display: flex; justify-content: space-between; font-size: 12px; color: var(--text); margin-bottom: 5px; font-weight: 600; }
.stat-bar { height: 6px; background: var(--surface2); border-radius: 3px; overflow: hidden; }
.stat-fill { height: 100%; border-radius: 3px; background: linear-gradient(90deg, var(--neon3), var(--neon)); box-shadow: var(--glow); transition: width 1s ease; }

/* ============ PROJECTS ============ */
.project-card {
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 18px;
  margin-bottom: 14px;
  transition: all 0.3s;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}
.project-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--neon3), var(--neon));
  opacity: 0;
  transition: opacity 0.3s;
}
.project-card:hover { border-color: var(--neon); box-shadow: 0 0 20px rgba(0,245,255,0.1); }
.project-card:hover::before { opacity: 1; }
.project-name {
  font-family: var(--font-head);
  font-size: 14px;
  font-weight: 700;
  color: var(--neon);
  letter-spacing: 1px;
  margin-bottom: 6px;
}
.project-desc { font-size: 13px; color: var(--text); line-height: 1.6; margin-bottom: 12px; font-weight: 400; }
.project-tags { display: flex; flex-wrap: wrap; gap: 6px; }
.project-tag {
  padding: 2px 8px;
  border-radius: 3px;
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 1px;
}
.tag-html { background: rgba(255,90,0,0.15); color: #ff5a00; border: 1px solid rgba(255,90,0,0.3); }
.tag-css { background: rgba(0,150,255,0.15); color: #0096ff; border: 1px solid rgba(0,150,255,0.3); }
.tag-js { background: rgba(255,215,0,0.15); color: var(--gold); border: 1px solid rgba(255,215,0,0.3); }
.tag-py { background: rgba(0,245,255,0.1); color: var(--neon); border: 1px solid rgba(0,245,255,0.3); }
.tag-live { background: rgba(0,255,100,0.1); color: #00ff64; border: 1px solid rgba(0,255,100,0.3); }
.project-status {
  position: absolute;
  top: 14px; right: 14px;
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 1px;
  padding: 3px 8px;
  border-radius: 3px;
}
.status-live { background: rgba(0,255,100,0.1); color: #00ff64; border: 1px solid rgba(0,255,100,0.3); }
.status-wip { background: rgba(255,215,0,0.1); color: var(--gold); border: 1px solid rgba(255,215,0,0.3); }

/* ============ TERMINAL ============ */
#terminal-window .win-content {
  background: #000;
  padding: 16px;
  font-family: var(--font-mono);
}
.term-output {
  min-height: 200px;
  color: #00ff64;
  font-size: 13px;
  line-height: 1.8;
  margin-bottom: 12px;
  white-space: pre-wrap;
}
.term-input-row {
  display: flex;
  align-items: center;
  gap: 8px;
  border-top: 1px solid #111;
  padding-top: 10px;
}
.term-prompt {
  color: var(--neon);
  font-size: 13px;
  white-space: nowrap;
}
#term-input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: #00ff64;
  font-family: var(--font-mono);
  font-size: 13px;
  caret-color: var(--neon);
}

/* ============ CV ============ */
.cv-section { margin-bottom: 24px; }
.cv-name {
  font-family: var(--font-head);
  font-size: 28px;
  font-weight: 900;
  color: var(--neon);
  text-shadow: var(--glow);
  letter-spacing: 3px;
  margin-bottom: 4px;
}
.cv-subtitle { font-family: var(--font-mono); font-size: 12px; color: var(--neon2); letter-spacing: 2px; margin-bottom: 20px; }
.cv-item { padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
.cv-item-title { font-weight: 700; color: var(--text); font-size: 14px; }
.cv-item-sub { font-size: 12px; color: var(--text-dim); margin-top: 2px; font-family: var(--font-mono); }
.cv-item-desc { font-size: 13px; color: var(--text); margin-top: 6px; line-height: 1.6; }
.download-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 20px;
  background: linear-gradient(135deg, var(--neon3), var(--neon));
  border: none;
  border-radius: 6px;
  color: #000;
  font-family: var(--font-head);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1px;
  cursor: pointer;
  margin-top: 16px;
  transition: all 0.3s;
  box-shadow: var(--glow);
}
.download-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(0,245,255,0.4); }

/* ============ CONTACT ============ */
.contact-links { display: flex; flex-direction: column; gap: 12px; }
.contact-link {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 20px;
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.3s;
  text-decoration: none;
  color: inherit;
}
.contact-link:hover { border-color: var(--neon); box-shadow: 0 0 20px rgba(0,245,255,0.1); transform: translateX(4px); }
.contact-link-icon { font-size: 24px; }
.contact-link-label { font-weight: 700; color: var(--text); font-size: 15px; }
.contact-link-value { font-family: var(--font-mono); font-size: 11px; color: var(--text-dim); margin-top: 2px; }
.contact-arrow { margin-left: auto; color: var(--text-dim); font-size: 18px; }

/* Resize handle */
.resize-handle {
  position: absolute;
  bottom: 0; right: 0;
  width: 16px; height: 16px;
  cursor: se-resize;
  background: linear-gradient(135deg, transparent 60%, var(--border) 60%);
}

/* Notifications */
.notif {
  position: fixed;
  top: 20px; right: 20px;
  background: var(--surface2);
  border: 1px solid var(--neon);
  border-radius: 8px;
  padding: 14px 18px;
  font-family: var(--font-body);
  font-size: 13px;
  color: var(--text);
  z-index: 99999;
  box-shadow: var(--glow), 0 10px 40px rgba(0,0,0,0.5);
  animation: notifIn 0.3s ease, notifOut 0.3s ease 2.7s forwards;
  max-width: 280px;
}
@keyframes notifIn { from { transform: translateX(120%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
@keyframes notifOut { to { transform: translateX(120%); opacity: 0; } }
.notif-title { font-family: var(--font-head); font-size: 10px; color: var(--neon); letter-spacing: 2px; margin-bottom: 5px; }

/* Welcome message floating */
.welcome-badge {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  pointer-events: none;
  animation: welcomeFade 1s ease 4.5s both, welcomeOut 0.8s ease 8s forwards;
  z-index: 500;
}
@keyframes welcomeFade { from { opacity: 0; transform: translate(-50%, -48%); } to { opacity: 1; transform: translate(-50%, -50%); } }
@keyframes welcomeOut { to { opacity: 0; transform: translate(-50%, -55%); } }
.welcome-line1 {
  font-family: var(--font-mono);
  font-size: 14px;
  color: var(--text-dim);
  letter-spacing: 4px;
  margin-bottom: 12px;
}
.welcome-line2 {
  font-family: var(--font-head);
  font-size: clamp(24px, 5vw, 52px);
  font-weight: 900;
  color: var(--neon);
  text-shadow: var(--glow), 0 0 80px rgba(0,245,255,0.4);
  letter-spacing: 4px;
}
.welcome-line3 {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--text-dim);
  letter-spacing: 2px;
  margin-top: 12px;
}

@media (max-width: 600px) {
  .info-grid { grid-template-columns: 1fr; }
  #taskbar .taskbar-btn span { display: none; }
  .taskbar-btn { padding: 5px 10px; }
}
</style>
</head>
<body>

<!-- Boot screen -->
<div id="boot">
  <div class="boot-logo">OMAR OS</div>
  <div class="boot-sub">DEVELOPER ENVIRONMENT v1.0</div>
  <div class="boot-bar-wrap"><div class="boot-bar"></div></div>
</div>

<!-- Visual layers -->
<div class="bg-grid"></div>
<div class="scanlines"></div>
<div class="watermark">OMAR AHMED · DEV · 2025</div>

<!-- Desktop -->
<div id="desktop">
  <div id="icon-area">
    <div class="desk-icon" onclick="openWindow('about-window')">
      <span class="icon-emoji">👤</span>
      <span class="icon-label">About Me</span>
    </div>
    <div class="desk-icon" onclick="openWindow('projects-window')">
      <span class="icon-emoji">🚀</span>
      <span class="icon-label">Projects</span>
    </div>
    <div class="desk-icon" onclick="openWindow('terminal-window')">
      <span class="icon-emoji">💻</span>
      <span class="icon-label">Terminal</span>
    </div>
    <div class="desk-icon" onclick="openWindow('cv-window')">
      <span class="icon-emoji">📄</span>
      <span class="icon-label">My CV</span>
    </div>
    <div class="desk-icon" onclick="openWindow('contact-window')">
      <span class="icon-emoji">📡</span>
      <span class="icon-label">Contact</span>
    </div>
  </div>

  <!-- TASKBAR -->
  <div id="taskbar">
    <div class="taskbar-logo">⬡ OMAR OS</div>
    <button class="taskbar-btn" onclick="openWindow('about-window')"><span class="taskbar-icon">👤</span><span>About</span></button>
    <button class="taskbar-btn" onclick="openWindow('projects-window')"><span class="taskbar-icon">🚀</span><span>Projects</span></button>
    <button class="taskbar-btn" onclick="openWindow('terminal-window')"><span class="taskbar-icon">💻</span><span>Terminal</span></button>
    <button class="taskbar-btn" onclick="openWindow('cv-window')"><span class="taskbar-icon">📄</span><span>CV</span></button>
    <button class="taskbar-btn" onclick="openWindow('contact-window')"><span class="taskbar-icon">📡</span><span>Contact</span></button>
